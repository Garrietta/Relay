<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Messaging: Relay is NOT the default SMS app (Garrett's directive
         2026-10-18). Google Messages keeps the default-SMS role so it can
         send/receive SMS; Relay pairs with it as a web client for RCS/SMS/MMS
         sync. READ_SMS is a read-only fallback for the unpaired state;
         SEND_SMS covers unpaired sending. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Foreground service for the RCS long-poll (remoteMessaging type).
         Android 14+ throws SecurityException on startForeground without
         these — that was the "Relay keeps stopping" crash on pairing
         completion (2026-10-18). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- microG Google-account pairing: enumerate com.google accounts so
         microG's authenticator can mint the OAuthLogin token. -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application
        android:name=".RelayApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Relay">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- RCS connection: foreground service keeps the long-poll alive under Doze. -->
        <service
            android:name=".rcs.service.RcsService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>
</manifest>

