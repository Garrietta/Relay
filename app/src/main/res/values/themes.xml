<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Relay" parent="android:Theme.Material.NoActionBar">
        <!-- White here is correct for light mode, but it flashed through during
             transitions in dark mode. MainActivity paints the window background
             programmatically to the effective theme color before first
             composition (see applyWindowBackgroundForTheme); values-night covers
             the launch frame when following the system theme. -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- No hardcoded windowLightStatusBar: enableEdgeToEdge() applies an
             auto SystemBarStyle that picks icon colors per mode. -->
        <!-- Dialog windows must never show the platform dialog theme's
             windowBackground (a light panel) for even one frame: Compose
             dialogs resolve android:dialogTheme from the activity theme, and
             the platform Theme.Material.Dialog background is light even when
             the app is in dark mode. Transparent here kills the flash at the
             theme level; Compose draws its own theme-driven scrim on top. -->
        <item name="android:dialogTheme">@style/Theme.Relay.Dialog</item>
    </style>

    <style name="Theme.Relay.Dialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <!-- The platform dim BEHIND the dialog window is the scrim: plain
             black-translucent, correct in both light and dark mode. The window
             itself is transparent so it can never flash a light panel. -->
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>
